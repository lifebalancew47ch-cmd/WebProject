# Copia este archivo a .env.local para desarrollo local (nunca lo commitees
# con valores reales). En Render, estas mismas variables se configuran desde
# el dashboard del servicio (Settings → Environment), no en un archivo.
#
# IMPORTANTE: al ser un sitio 100% estático (output: 'export', sin servidor
# propio), CUALQUIER variable que la app necesite en tiempo de ejecución debe
# llevar el prefijo NEXT_PUBLIC_ — Next.js las incrusta directo en el bundle
# de JavaScript que se descarga en el navegador. Eso significa que ninguna
# de estas variables puede ser un secreto real (API key privada, credencial
# de base de datos, etc.): todo lo que empiece con NEXT_PUBLIC_ es, por
# definición, público. Si algún día se necesita un valor verdaderamente
# secreto, este proyecto tendría que dejar de ser un export estático.

# Base URL del servicio de Auth & Profile
NEXT_PUBLIC_AUTH_API_URL=https://lifebalance-auth-service.onrender.com

# Base URL del servicio de Notifications & Alerts
NEXT_PUBLIC_NOTIFICATIONS_API_URL=https://lifebalance-notifications-api.onrender.com

# Base URL del servicio de Dashboard
NEXT_PUBLIC_DASHBOARD_API_URL=https://lifebalance-dashboard-service.onrender.com

# Base URL del servicio de Organization & SaaS
NEXT_PUBLIC_ORGANIZATIONS_API_URL=https://lifebalance-organization-saas.onrender.com

# Base URL del servicio de Reporting
NEXT_PUBLIC_REPORTING_API_URL=https://lifebalance-reporting-service.onrender.com

# Stripe Payment Links (opcional). Sin configurar, "Seleccionar Plan" abre el
# modal de confirmación en vez de redirigir a Stripe — ver
# components/landing/PricingSection.tsx.
NEXT_PUBLIC_STRIPE_CHECKOUT_URL_INDIVIDUAL=
NEXT_PUBLIC_STRIPE_CHECKOUT_URL_CORPORATIVO=
