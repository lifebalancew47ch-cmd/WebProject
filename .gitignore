# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — nunca deben trackearse, ni siquiera .env "de ejemplo" con
# valores reales. Usa .env.example (sin valores reales) para documentar
# qué variables existen.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code — settings.local.json es config/permite-comandos por máquina,
# y en la práctica termina acumulando URLs y credenciales de prueba pegadas
# en los comandos que se fueron aprobando (encontrado: credenciales de la
# cuenta demo en texto plano). settings.json (sin .local, si existiera) sí
# se puede trackear porque es config de equipo sin datos sensibles.
.claude/settings.local.json
